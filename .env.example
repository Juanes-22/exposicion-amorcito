# Copiar a .env (ignorado por Git). Todos los valores son opcionales en desarrollo.
PORT=3001
# Interfaz de red. 0.0.0.0 (por defecto) permite entrar desde celulares de la red local; 127.0.0.1 solo desde esta computadora.
HOST=0.0.0.0
# Ruta del archivo SQLite. En producción: un volumen que sobreviva a los reinicios.
DATABASE_PATH=server/data/laboratorio.sqlite
# Origen permitido del frontend (CORS de Socket.IO y API). En producción el frontend se sirve desde el mismo origen.
ALLOWED_ORIGIN=http://localhost:5173
# Vencimiento de sala por inactividad de la administradora (ms). Por defecto, 2 horas.
ADMIN_IDLE_TTL_MS=7200000
# Retención de datos de una sala terminal antes de limpiarla (ms). Por defecto, 24 horas.
TERMINAL_RETENTION_MS=86400000
# Cada cuánto el servidor revisa vencimientos y limpieza (ms). Por defecto, 30 s.
SWEEP_INTERVAL_MS=30000
# Latido de Socket.IO (ms): detecta cortes de red en ≤ 10 s. Por defecto, 4 s + 5 s.
PING_INTERVAL_MS=4000
PING_TIMEOUT_MS=5000

# --- Producción (detrás de un proxy con HTTPS) ---
# Dirección pública con la que se construyen el QR y los enlaces de entrada (sin barra final). Obligatoria detrás de un proxy.
# PUBLIC_ORIGIN=https://mi-laboratorio.example.com
# Detrás de un proxy/balanceador: sin esto TODAS las personas parecen venir de la misma IP y los límites de entrada se aplican juntos.
# TRUST_PROXY=1
