{
  "name": "laboratorio-cosas-cotidianas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "El laboratorio de las cosas cotidianas: aventura interactiva sobre la curiosidad (sala compartida con rondas guiadas y participación simultánea). React + Vite + TypeScript + Phaser; servidor Node + Socket.IO + SQLite.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "validate:project": "tsx scripts/validate-project.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vite build && tsx scripts/e2e/strictmode.ts && tsx scripts/e2e/room-flow.ts && tsx scripts/e2e/movement.ts && tsx scripts/e2e/rounds.ts && tsx scripts/e2e/restart.ts && tsx scripts/e2e/demo.ts && tsx scripts/e2e/tiled-direct.ts",
    "build": "npm run validate:project && npm run typecheck && vite build",
    "start": "tsx server/src/index.ts",
    "test:load": "tsx scripts/load/capacity.ts",
    "ensayo": "tsx scripts/rehearsal/room.ts",
    "preview:demo": "vite build && vite preview --host 127.0.0.1 --port 4173 --strictPort --open /demo"
  },
  "dependencies": {
    "@fontsource-variable/gelasio": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "phaser": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
